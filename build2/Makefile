# target to generate assembly for a file
src/unpack.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/JHS.dir/build.make CMakeFiles/JHS.dir/src/unpack.cpp.s
.PHONY : src/unpack.cpp.s

src/util.o: src/util.cpp.o
.PHONY : src/util.o

# target to build an object file
src/util.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/JHS.dir/build.make CMakeFiles/JHS.dir/src/util.cpp.o
.PHONY : src/util.cpp.o

src/util.i: src/util.cpp.i
.PHONY : src/util.i

# target to preprocess a source file
src/util.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/JHS.dir/build.make CMakeFiles/JHS.dir/src/util.cpp.i
.PHONY : src/util.cpp.i

src/util.s: src/util.cpp.s
.PHONY : src/util.s

# target to generate assembly for a file
src/util.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/JHS.dir/build.make CMakeFiles/JHS.dir/src/util.cpp.s
.PHONY : src/util.cpp.s

